{
  "name": "tab-editor-for-ableton-live",
  "version": "0.17.0",
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build:ui": "vite build",
    "build": "npm run build:ui && tsc --noEmit && tsx build.ts",
    "start": "npm run build:ui && tsx build.ts && extensions-cli run",
    "package": "npm run build && extensions-cli package -i dist-ui/index.html",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p ui",
    "build:dev": "vite build --mode dev && tsx build.ts --dev",
    "dev": "npm run build:dev && extensions-cli run --storage-directory .devstore"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:vendor/ableton-extensions-sdk-1.0.0-beta.1.tgz",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:vendor/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@coderline/alphatab": "^1.8.3",
    "@types/node": "^25.9.2",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.2.4"
  }
}
